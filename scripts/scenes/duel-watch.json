{
  "name": "duel-watch",
  "about": "Three couriers (needs `ARENA_BATTLES=on npm run dev`): two duel on the duel island while the third taps the duel mark and watches from the stands until the end, then they swap so the duel island and the watcher's view show on a phone and a tablet in both languages. The first duel ends with a give-up; in the second a duellist's connection drops and the watcher sees the fight wait.",
  "players": [
    { "id": "lan", "name": "Scena Lan", "avatar": "green", "browser": "chromium", "device": "iphone-portrait", "language": "en", "prepared": { "at": { "x": 14, "y": 16 }, "team": [{ "species": "glowbun", "level": 8 }, { "species": "puddlepip", "level": 7 }, { "species": "pinwhirl", "level": 6 }] } },
    { "id": "zarja", "name": "Scena Zarja", "avatar": "purple", "browser": "webkit", "device": "ipad-landscape", "language": "sl", "prepared": { "at": { "x": 16, "y": 16 }, "team": [{ "species": "dawnshell", "level": 12 }, { "species": "snowsnoot", "level": 10 }, { "species": "boltkit", "level": 9 }, { "species": "gustowl", "level": 5 }] } },
    { "id": "mira", "name": "Scena Mira", "avatar": "orange", "browser": "webkit", "device": "iphone-portrait", "language": "en", "prepared": { "at": { "x": 18, "y": 16 }, "team": [{ "species": "bloomlet", "level": 5 }, { "species": "gustowl", "level": 5 }, { "species": "rimemoth", "level": 5 }] } }
  ],
  "steps": [
    { "do": "join", "player": "lan" },
    { "do": "join", "player": "zarja" },
    { "do": "join", "player": "mira" },
    { "do": "waitFor", "player": "lan", "until": { "seesAt": { "zarja": { "x": 16, "y": 16 } } } },
    { "do": "waitFor", "player": "mira", "until": { "seesAt": { "lan": { "x": 14, "y": 16 }, "zarja": { "x": 16, "y": 16 } } } },
    { "do": "ask", "player": "lan", "to": "zarja", "even": false },
    { "do": "answer", "player": "zarja", "yes": true },
    { "do": "waitFor", "player": "lan", "until": { "arena": "rounds", "arenaPhase": "picking" } },
    { "do": "waitFor", "player": "zarja", "until": { "arena": "rounds", "arenaPhase": "picking" }, "shot": "pick" },
    { "do": "waitFor", "player": "mira", "until": { "duelling": ["lan", "zarja"] } },
    { "do": "watch", "player": "mira", "who": "lan" },
    { "do": "waitFor", "player": "mira", "until": { "arena": "watching" }, "shot": "watching-picks" },
    { "do": "pick", "player": "lan" },
    { "do": "pick", "player": "zarja" },
    { "do": "waitFor", "player": "lan", "until": { "arenaPhase": "fighting" } },
    { "do": "waitFor", "player": "zarja", "until": { "arenaPhase": "fighting" } },
    { "do": "waitFor", "player": "mira", "until": { "arena": "watching", "arenaPhase": "fighting" } },
    { "do": "wait", "ms": 1500, "shot": "duel-island" },
    { "do": "giveUp", "player": "zarja" },
    { "do": "waitFor", "player": "lan", "until": { "arenaPhase": "ended" } },
    { "do": "waitFor", "player": "mira", "until": { "arena": "watching", "arenaPhase": "ended" } },
    { "do": "wait", "ms": 2500, "shot": "watched-to-end" },
    { "do": "continue", "player": "lan" },
    { "do": "continue", "player": "zarja" },
    { "do": "continue", "player": "mira" },
    { "do": "waitFor", "player": "mira", "until": { "trophy": ["lan"], "seesAt": { "lan": { "x": 14, "y": 16 } } } },
    { "do": "waitFor", "player": "zarja", "until": { "trophy": ["lan"] }, "shot": "trophy" },
    { "do": "ask", "player": "mira", "to": "lan", "even": true },
    { "do": "answer", "player": "lan", "yes": true },
    { "do": "waitFor", "player": "zarja", "until": { "duelling": ["lan", "mira"] } },
    { "do": "watch", "player": "zarja", "who": "mira" },
    { "do": "pick", "player": "mira" },
    { "do": "pick", "player": "lan" },
    { "do": "waitFor", "player": "mira", "until": { "arenaPhase": "fighting" } },
    { "do": "waitFor", "player": "lan", "until": { "arenaPhase": "fighting" } },
    { "do": "waitFor", "player": "zarja", "until": { "arena": "watching", "arenaPhase": "fighting" } },
    { "do": "wait", "ms": 1500, "shot": "second-duel" },
    { "do": "wait", "ms": 4000 },
    { "do": "drop", "player": "mira", "ms": 4000 },
    { "do": "waitFor", "player": "zarja", "until": { "arena": "watching", "paused": true }, "shot": "waiting" },
    { "do": "waitFor", "player": "zarja", "until": { "arena": "watching", "paused": false }, "ms": 30000 },
    { "do": "giveUp", "player": "lan" },
    { "do": "waitFor", "player": "zarja", "until": { "arena": "watching", "arenaPhase": "ended" } },
    { "do": "wait", "ms": 2500, "shot": "watched-second" },
    { "do": "continue", "player": "mira" },
    { "do": "continue", "player": "lan" },
    { "do": "continue", "player": "zarja" },
    { "do": "waitFor", "player": "zarja", "until": { "trophy": ["mira"] } }
  ]
}

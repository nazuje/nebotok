    "pitch2-pace2": {
      "Delo zame z deske? Čudovito. Prinesi vse, ko zbereš. Potrudil se bom, da ne pozabim!": "649f9900776f07aa.mp3",
      "Dobro. Pojdi po poti proti vzhodu, dokler ne začutiš vetra.": "31345135c44fdc9d.mp3",
      "Hvala! Mehurka skrbi za svetišče, malo vzhodno od tod. Previdno, zvonec zazvoni ob vsakem koraku.": "18fd8951fe575b01.mp3",
      "Hvala. Pohiti in pazi, ker močno piha.": "c50640456b0aab40.mp3",
      "Imam sporočilo za Tobolka, tam pri travniku. Mu ga lahko neseš?": "238182512547d569.mp3",
      "Kaj je novega s sivim pismom? Vetrinka bo vedela, kaj storiti.": "cc172b4286da06c2.mp3",
      "Mehurka pravi, da počitek v svetišču dela čudeže. Poskusi.": "5cd79eb17da32160.mp3",
      "Mehurka čaka na zvonec. Svetišče je malo vzhodno od tod.": "b68154e2242285c0.mp3",
      "Ni treba hiteti. Pisma lahko počakajo.": "42ee759db5c5b58e.mp3",
      "Odlično! Tu je sporočilo. Tobolko je pri travniku, zahodno od tod.": "63dfe3063f289671.mp3",
      "Oh! Nekdo nov na pošti! Lepo, da si tu. Sem Bavko, poštar Nebesne pošte.": "f0f36873b1a804af.mp3",
      "Opravi katero koli delo z deske. Nagrado dobiš takoj.": "bf1ad15949bcc20d.mp3",
      "Pismo je spet tu? Naj ga še enkrat pogledam.": "10097e0085e35e75.mp3",
      "Počakaj. Naslovljeno je na ... tebe. »Za novi obraz na Nebesni pošti.«": "1e12fd1f5716ea42.mp3",
      "Prav to je pošta potrebovala! Hvala, hvala.": "ea7b55c9262283ed.mp3",
      "Stari zvonec v svetišču je počil v zadnjem močnem sunku vetra. Imam novega. Ga odneseš Mehurki?": "9f234eb8c25c0a03.mp3",
      "Tisto pismo je našlo tebe, ne ti njega. Kar koli je tam zunaj, Nebesna pošta je s tabo.": "717a91cd9b7059fd.mp3",
      "To je oglasna deska, kjer se nabirajo priložnostna dela. Opravi katero koli! Ko eno končaš, se pojavi novo.": "c420cb8e993a20f4.mp3",
      "Tobolko te je iskal. Je pri travniku, zahodno od tod.": "cde5d29cb98cbf31.mp3",
      "Tobolko čaka na tisto sporočilo. Najdeš ga pri travniku.": "8585e1a9f5045ba2.mp3",
      "Tole je zjutraj prinesel veter. Sivo pismo, čisto mokro, brez pošiljatelja.": "4f38272bcda5ca3b.mp3",
      "Tu nihče ne nosi pošte sam. Izberi bitje, ki bo potovalo s tabo, nato se vrni po prvo pošiljko.": "13e65b7b7ee956e1.mp3",
      "Veter je danes nežen. Pravo vreme za pisma.": "16545f995a25e01b.mp3",
      "Vetrinka je pri vzhodnem razgledišču. Vetrove pozna bolje kot kdorkoli.": "4ee1f2bf5d2ab707.mp3",
      "Vetrinka pri vzhodnem razgledišču je prosila za ta vetromer. Kaže, kako močno piha veter. Ga odneseš?": "cdae07ff544ee3c5.mp3",
      "Vetrinka ve vse o vremenu. Morda bo razumela tudi tole. Ji ga odneseš?": "7d257d9c90dd3feb.mp3"
    },
    "pitch3-pace1": {
      "Domače poslastice delujejo še bolje! Naberi 3 oblačnice, nato v mojem loncu skuhaj jagodno žemljico.": "e3c9eda8af031f6d.mp3",
      "Dve zmagi v visoki travi in travnik se bo umiril. Verjamem vate!": "d6c50ad1a3300e97.mp3",
      "Grmi oblačnic so ob travniku, lonec pa je kar tu ob meni.": "fc78067cf3487b6a.mp3",
      "Jagodna žemljica! Čudovito diši. Zdaj pojdi k Bavku. Njegova oglasna deska je ob vratih pošte.": "6e7b72c57304152d.mp3",
      "Novo bitje v ekipi! Poglej, kako je veselo. Za to so poslastice.": "8494683d187c4e07.mp3",
      "Oh, bitja na travniku so danes tako nemirna! Jih pomiriš? Zmagaj v 2 bojih v visoki travi.": "db4daa8aad9f2505.mp3",
      "Oh, zame? Kako lepo, kako lepo! Hvala!": "92ce97a26a35c699.mp3",
      "Ojej, je tisto delo na deski zame? Ni treba hiteti. Prinesi vse, ko zbereš.": "97782528cae189a9.mp3",
      "Poslastice, torbe in še več poslastic. To je moje delo!": "def8f2770883af41.mp3",
      "Poslušaj! Travnik se je umiril. Odlično opravljeno!": "e29607f44edfffab.mp3",
      "Seveda, seveda. Trava bo počakala. Vedno počaka.": "e4cbce1c933e64d2.mp3",
      "Sporočilo od Bavka? Zame? Hvala!": "7165a76c69958fb5.mp3",
      "Super! Visoka trava je kar tu. Vrni se, ko končaš.": "ec1d5c50db74c5fc.mp3",
      "Ti je zmanjkalo poslastic? Ojej, ojej! Na, vzemi tri navadne. Vsakdo si zasluži še en poskus.": "347c23cceb8100b9.mp3",
      "Ti je že uspelo? V boju ponudi poslastico. Utrujena bitja pogosteje rečejo ja.": "79539a9a7f4d98bf.mp3",
      "Tri oblačnice, nato jagodna žemljica v loncu. Preprosto in okusno!": "4887eee40d6bb4ca.mp3",
      "V torbi imaš poslastice za divja bitja, tu so še tri. Poglej vanjo, kadar želiš.": "d6fa9f16bdfe8cec.mp3",
      "Vetrinka pravi, da je v oblakih nekaj čudnega. Za vsak primer imam pripravljenih več poslastic.": "add8b672e0afc9b8.mp3",
      "Zdaj pa moj najljubši del. V boju ponudi poslastico divjemu bitju. Če te ima rado, se pridruži tvoji ekipi!": "8e3c30c585441c1f.mp3",
      "Čudovito! Utrujeno bitje pogosteje reče ja. Najbolje deluje njegova najljubša poslastica.": "f2a2f22d78ccf3cb.mp3"
    },
    "pitch4-pace1": {
      "Delo z deske. Prinesi vse. Brez naglice.": "4d0eec8a7a4ce98d.mp3",
      "Mehurčki danes drhtijo. Nekaj daleč stran. Ostani blizu svetišča.": "04661e65b9b49e15.mp3",
      "Mehurčki se dvigajo. Počitek pride. Svetišče je mirno.": "65e6c059c44c6749.mp3",
      "Nov zvonec. Čist glas. Hvala.": "5cb9851c34ccce2a.mp3",
      "Stopi do svetišča, da počiješ. Dihaj. Glej mehurčke.": "3c51ac871e5e0a3a.mp3",
      "Stopi do svetišča, da počiješ. Poskusi zdaj. Mehurčki pomagajo.": "494a18470dd4299b.mp3",
      "To svetišče zdravi. Če tvoja ekipa omedli, se zbudiš tu. Na varnem.": "00f7c2bde51c0d88.mp3",
      "Zame. Prijazno. Hvala.": "c9be37c45fc412fd.mp3"
    },
    "pitch4-pace3": {
      "Bavko mora videti tisto pismo. Pohiti nazaj na pošto.": "d2a7021539158187.mp3",
      "Delo z deske zame? Prinesi vse skupaj. Veter ne čaka, jaz pa počakam.": "38ca88a8d7dd3291.mp3",
      "Dober poskus! Morda izberi druge tri in se vrni. Jaz bom tu, pri oblakih.": "3f62c427c063856c.mp3",
      "Hm. Veter se spet obrača proti vzhodu. To mi ni všeč.": "83c1250c5a671480.mp3",
      "Hvala za pomoč. Povej Bavku, da bom še naprej opazovala nebo.": "b001b17eb996d99b.mp3",
      "Moj vetromer! Končno. Bavko nikoli ne pozabi ... no, včasih pozabi.": "0fc1c20cebbe06c0.mp3",
      "Odlično! Tvoja bitja ti zaupajo. Vrni se na nov dvoboj, kadar želiš.": "4cdf457f54e650b4.mp3",
      "Odnesi pismo nazaj Bavku. To mora videti.": "1ca1d666e16f4b94.mp3",
      "Pa drugič. Oblaki ne gredo nikamor.": "1015944ac1d34209.mp3",
      "Pojdi na razgledišče, malo vzhodno od mene. Poglej čez morje oblakov. Hitro!": "c666366580170e39.mp3",
      "Prijateljski preizkus: zmaga, kdor prvi dobi dve rundi. Dobro izberi svoje tri!": "37706f7fd2aa124d.mp3",
      "Ravno pravi čas, preden se veter obrne. Hvala!": "9965304a4a926d0c.mp3",
      "Razgledišče je malo vzhodno od mene. Pojdi in poglej čez oblake.": "fc0f06ae5671c535.mp3",
      "Sivo pismo, ki ga je prinesel veter? Naj ga preberem ...": "5f40e53dff73ab1f.mp3",
      "Tam močno piha, kajne? In čudno. Pošta z zunanjih otokov ne prihaja več. Že več dni niti enega pisma.": "8c2ff182fc104644.mp3",
      "To ni bila nevihta. Nevihte ne jedo.": "12a60e918d767ae9.mp3",
      "Vetrovna trava je na jugozahodu. Tam zmagaj v enem boju, nato se vrni. Pretežko? Najprej treniraj na travniku.": "00bffdea00f1592c.mp3",
      "Vidiš, kako se vrti? Veter je danes čuden. Zmagaj v boju v vetrovni travi na jugozahodu, nato se vrni k meni.": "4fa4a15f581f03cd.mp3",
      "Zdaj vsak dan opazujem daljne oblake. Si za premor? Preizkusiva tvoja bitja: tri moja proti trem tvojim.": "59253bbc6c0e506d.mp3",
      "Zdaj vsak dan opazujem daljne oblake. Če se tisto vrne, ga bomo pravočasno opazili.": "d9b7dfd912e77acb.mp3",
      "»Oblaki nad daljnimi otoki utihujejo. Nekaj tam zunaj je lačno.«": "8d450e6eb5a53b09.mp3"
    }

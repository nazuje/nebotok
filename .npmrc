# Supply-chain settings for every npm command in this repo. See docs/security.md.
# Never run a package's install scripts. Nothing here needs one; see docs/security.md if that changes.
ignore-scripts=true
# Write exact versions to package.json, never ranges.
save-exact=true
# Refuse to install with the wrong Node version.
engine-strict=true
audit=true
# Only resolve versions published at least 7 days ago, so a hijacked release has time to be caught.
min-release-age=7
# No dependencies straight from git repositories.
allow-git=none

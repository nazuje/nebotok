#!/bin/sh
# Turned on per clone by `npm run setup:hooks`. Runs the level 0 proof before anything leaves
# this computer: lint, types, unit tests, content, core boundary, agent setup and the secret scan.
# It writes .proof/<sha>/L0/ and leaves a higher level's .proof/<sha>/summary.json standing.
set -eu
cd "$(git rev-parse --show-toplevel)"
exec npm run verify -- --level 0
